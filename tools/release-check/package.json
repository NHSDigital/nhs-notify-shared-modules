{
  "bin": {
    "release-check": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "main": "./dist/index.js",
  "name": "@nhsdigital/nhs-notify-release-check",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.0.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHSDigital/nhs-notify-shared-modules.git",
    "directory": "tools/release-check"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsx ./src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "rm -rf dist",
    "prepack": "npm run build",
    "test:unit": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
